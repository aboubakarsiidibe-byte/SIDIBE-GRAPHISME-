# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where this app is hosted.
APP_URL="MY_APP_URL"

# Supabase V2
# Create these values in your Supabase project settings.
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
